# Galaxy configuration
GALAXY_CONFIG_BRAND=Methylator
GALAXY_ADMIN_USER=admin
GALAXY_ADMIN_PASSWORD=password
GALAXY_ADMIN_API_KEY=fakekey

# Startup configuration
GALAXY_STARTUP_WAIT=120
GALAXY_LOG_LEVEL=INFO

# Memory and performance
GUNICORN_WORKERS=2
GALAXY_DATABASE_CONNECTION=postgresql://postgres:password@postgres:5432/galaxy

# Enable Galaxy debug (set to false in production)
GALAXY_CONFIG_DEBUG=false
